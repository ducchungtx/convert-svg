# Production Environment Configuration
NODE_ENV=production
PORT=3001

# Frontend URL for CORS (Update with your domain)
FRONTEND_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# Database Configuration (for Docker)
DB_ROOT_PASSWORD=your_super_secure_root_password
DB_PASSWORD=your_secure_database_password
DATABASE_URL="mysql://convert_user:${DB_PASSWORD}@db:3306/convert_db"

# For standalone deployment (without Docker)
# DATABASE_URL="mysql://convert_user:your_password@localhost:3306/convert_db"

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
REDIS_DB=0

# For standalone deployment
# REDIS_HOST=localhost
# REDIS_URL=redis://localhost:6379

# JWT Configuration (Generate strong secrets!)
JWT_SECRET=your-super-secure-jwt-secret-for-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-for-production-min-32-chars
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads
CLEANUP_INTERVAL=3600000

# Rate Limiting (More strict for production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50
RATE_LIMIT_AUTHENTICATED_MAX=200

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
ERROR_LOG_FILE=./logs/error.log

# External Services (Docker paths)
IMAGEMAGICK_PATH=/usr/bin/convert
GHOSTSCRIPT_PATH=/usr/bin/gs
PDF2SVG_PATH=/usr/bin/pdf2svg
POTRACE_PATH=/usr/bin/potrace

# Security (Production settings)
BCRYPT_ROUNDS=12
SESSION_SECRET=your-super-secure-session-secret-for-production
TRUST_PROXY=true
SECURE_COOKIES=true

# File Cleanup
FILE_RETENTION_DAYS=7
ALLOWED_FORMATS=svg,png,jpg,jpeg,pdf,eps

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50
GUEST_RATE_LIMIT=3
USER_RATE_LIMIT=25
PREMIUM_RATE_LIMIT=200

# Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-super-secure-admin-password

# SSL Configuration (if using HTTPS)
SSL_CERT_PATH=/etc/ssl/certs/certificate.crt
SSL_KEY_PATH=/etc/ssl/private/private.key
