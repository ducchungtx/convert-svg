# Environment Configuration
NODE_ENV=development
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Docker MySQL cho macOS development)
DATABASE_URL="mysql://convert_user:dev_password@127.0.0.1:3306/convert_db"

# Redis Configuration (Docker Redis cho macOS development)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads
CLEANUP_INTERVAL=3600000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTHENTICATED_MAX=500

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# External Services (optional)
IMAGEMAGICK_PATH=/usr/local/bin/convert
GHOSTSCRIPT_PATH=/usr/local/bin/gs
PDF2SVG_PATH=/usr/local/bin/pdf2svg

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-this

# Production Settings
TRUST_PROXY=false
SECURE_COOKIES=false

# File Cleanup
FILE_RETENTION_DAYS=7
ALLOWED_FORMATS=svg,png,jpg,jpeg,pdf,eps

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
GUEST_RATE_LIMIT=5
USER_RATE_LIMIT=50
PREMIUM_RATE_LIMIT=500

# External APIs (Optional)
IMAGEMAGICK_PATH=/usr/bin/convert
POTRACE_PATH=/usr/bin/potrace
GHOSTSCRIPT_PATH=/usr/bin/gs

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
ERROR_LOG_FILE=./logs/error.log

# Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password
