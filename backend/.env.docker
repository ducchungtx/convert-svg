# Docker environment variables
# Copy this file to .env and update with your values

# Database
DB_ROOT_PASSWORD=your_super_secure_root_password
DB_PASSWORD=your_secure_db_password

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-for-production-256-bit-key
JWT_REFRESH_SECRET=your-super-secret-refresh-key-for-production-256-bit-key

# Application
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# File Upload
MAX_FILE_SIZE=104857600

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTHENTICATED_MAX=5000
