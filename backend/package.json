{
  "name": "file-conversion-backend",
  "version": "1.0.0",
  "description": "Backend API for file conversion website with Next.js 15 + MySQL",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "build": "echo 'Backend build completed'",
    "worker": "node src/jobs/worker.js",
    "migrate": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "generate": "npx prisma generate",
    "seed": "node prisma/seed.js",
    "studio": "npx prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .js,.ts",
    "format": "prettier --write 'src/**/*.{js,ts,json}'"
  },
  "keywords": [
    "file-conversion",
    "svg",
    "png",
    "pdf",
    "eps",
    "nextjs",
    "mysql",
    "prisma",
    "express"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "canvas": "^2.11.2",
    "pdf2pic": "^3.0.4",
    "pdf-lib": "^1.17.1",
    "potrace": "^2.1.8",
    "@prisma/client": "^5.7.1",
    "mysql2": "^3.6.5",
    "bullmq": "^4.15.4",
    "ioredis": "^5.3.2",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "mime-types": "^2.1.35",
    "file-type": "^19.0.0",
    "uuid": "^9.0.1",
    "cron": "^3.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.7.1",
    "@types/node": "^20.10.4",
    "@types/express": "^4.17.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/mime-types": "^2.1.4",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}